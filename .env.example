# 复制为 .env 后填写。环境变量优先于这里的值。

# ===== 云端大模型（任何 OpenAI 兼容接口）=====
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-在这里填DeepSeek的key
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# ===== 本地模型服务（oMLX）=====
# 向量模型和重排模型由 oMLX 提供，模型在 oMLX 管理后台下载。
# 后端可选：omlx（调用 oMLX）/ local（本进程加载）/ none（不用模型）
# 在 Windows 上开发、没有模型时，两个都设成 none：只做关键词检索，不重排
EMBED_BACKEND=omlx
RERANK_BACKEND=omlx
# oMLX 的地址，默认端口 8000
OMLX_BASE_URL=http://127.0.0.1:8000/v1
# 本机访问 oMLX 可以不设 key；oMLX 监听局域网地址时必须设置，和 oMLX 里配置的保持一致
OMLX_API_KEY=
# 模型名：填 oMLX 里的模型目录名或别名（oMLX 管理后台或 GET /v1/models 可以看到）
EMBED_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3

# ===== 端口（和服务器上已有服务冲突时改这里）=====
# 本项目 API 服务的端口（oMLX 默认占用 8000，所以这里用 8800）
API_PORT=8800
# Qdrant 映射到本机的端口（只监听 127.0.0.1）
QDRANT_PORT=6333
# Open WebUI 网页端口，浏览器访问 http://<主机>:WEBUI_PORT
WEBUI_PORT=3000

# ===== 本服务 =====
# Open WebUI 调用本服务用的密钥，换成一串随机字符（openssl rand -hex 32）
LOCALBRAIN_API_KEY=change-me
# 只给本机和 Open WebUI 用就保持 127.0.0.1；想在手机、其他电脑上打开文档管理页面，改成 0.0.0.0
API_HOST=127.0.0.1
# 文档管理页面 http://<主机>:API_PORT/kb 的登录密码，不设置则页面不可用
WEB_PASSWORD=
# 回答里的出处会变成链接，点开直接看原文（PDF 跳到对应页）。这里是链接的地址前缀，留空自动推断：
# API_HOST 是 127.0.0.1 时为 http://127.0.0.1:API_PORT（只有本机能打开）；是 0.0.0.0 时为 http://<本机名>.local:API_PORT
# 用 Tailscale 在外面访问的话，填 Tailscale 的地址，比如 http://100.x.x.x:8800
# PUBLIC_URL=
# Open WebUI 的登录会话密钥，换成另一串随机字符
WEBUI_SECRET_KEY=change-me-too

# ===== 知识库 =====
# 把文档放进这个目录就会自动入库（相对路径以项目根目录为准）
DOCS_DIR=data/docs
DB_PATH=data/localbrain.db
COLLECTION=localbrain
# 默认连 http://127.0.0.1:QDRANT_PORT，一般不用填。
# 填一个本地目录（如 data/qdrant_local）则不用 Docker，以嵌入模式运行（只能单进程访问，开发用）
# QDRANT_URL=

# ===== 文档解析 =====
# docling：识别标题层级和表格，需要 Docling 的版面模型（约 370MB）
# simple：只提取 PDF 文字层，不需要模型，开发调试用
PDF_PARSER=docling
# Docling 模型的本地目录。留空则第一次解析 PDF 时自动从 HuggingFace 下载（国内较慢），预先下载的方法见 README
# DOCLING_ARTIFACTS_PATH=data/models/docling
# 图片和扫描版 PDF 的 OCR，只在 macOS 上生效（用系统自带的 Vision 框架）
#   auto：PDF 有文字层就不 OCR，缺文字层的页超过两成才按扫描件 OCR；图片总是 OCR
#   always：PDF 里的插图、截图也 OCR，解析慢 4 倍左右
#   never：不 OCR
OCR=auto
# 并行解析的进程数，每个占 2～4GB 内存（上千页的书在 4GB 左右）。解析主要卡在 GPU 上，再多提升不大
INGEST_WORKERS=2
# 单个文件解析超过这么多秒就放弃并记为失败，防止一个坏文件卡住入库
PARSE_TIMEOUT=3600

# ===== 网络（按需）=====
# launchd 启动的服务不会继承终端里的代理设置，需要代理就写在这里
# HTTPS_PROXY=http://127.0.0.1:7897
